{
  "uid": "forensic-logs",
  "title": "Forensic raw logs (SENSITIVE)",
  "tags": ["log-pipeline", "forensic"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Raw records per minute by service",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8},
      "datasource": {"type": "loki", "uid": "loki-forensic"},
      "targets": [{"refId": "A", "expr": "sum by (service) (count_over_time({job=\"forensic\"}[1m]))",
                   "legendFormat": "{{service}}"}]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Raw logs: contains personal data, restricted access, 3-year retention",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 16},
      "datasource": {"type": "loki", "uid": "loki-forensic"},
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{job=\"forensic\"}"}]
    }
  ]
}
